# El código se ejecuta dentro de un contenedor Linux y en Databricks.
# Sin esto, los ficheros con finales de línea CRLF de Windows fallan en el
# contenedor con errores crípticos (p. ej. "bad interpreter: no such file").
* text=auto eol=lf

# Ficheros que deben conservar finales de línea de Windows
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binarios: nunca convertir
*.parquet binary
*.png binary
*.jpg binary
*.gz binary
*.zip binary
