# Copiar a .env y rellenar. El fichero .env está en .gitignore y NUNCA debe
# commitearse.
#
#   cp .env.example .env
#
# El token se genera en Databricks: Settings -> Developer -> Access tokens.
# Conviene ponerle una caducidad corta; para un proyecto de portafolio no hay
# motivo para emitir un token sin vencimiento.

DATABRICKS_HOST=https://dbc-XXXXXXXX-XXXX.cloud.databricks.com
DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
