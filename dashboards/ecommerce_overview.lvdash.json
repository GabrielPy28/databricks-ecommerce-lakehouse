{
  "datasets": [
    {
      "name": "ds_kpis",
      "displayName": "KPIs de cabecera",
      "queryLines": [
        "SELECT\n",
        "    sum(net_revenue)                   AS ingreso_neto,\n",
        "    sum(orders)                        AS ordenes,\n",
        "    round(avg(average_order_value), 2) AS ticket_medio,\n",
        "    (SELECT count(*) FROM ecommerce.gold.customer_lifetime_value) AS clientes\n",
        "FROM ecommerce.gold.daily_sales\n"
      ]
    },
    {
      "name": "ds_daily",
      "displayName": "Ingreso diario",
      "queryLines": [
        "SELECT date, net_revenue, orders, customers\n",
        "FROM ecommerce.gold.daily_sales\n",
        "ORDER BY date\n"
      ]
    },
    {
      "name": "ds_country",
      "displayName": "Ingreso por país",
      "queryLines": [
        "SELECT country, sum(total_spend) AS ingreso, count(*) AS clientes\n",
        "FROM ecommerce.gold.customer_lifetime_value\n",
        "WHERE country IS NOT NULL\n",
        "GROUP BY country\n",
        "ORDER BY ingreso DESC\n"
      ]
    },
    {
      "name": "ds_segments",
      "displayName": "Segmentos RFM",
      "queryLines": [
        "SELECT segment, count(*) AS clientes, round(sum(total_spend), 2) AS ingreso\n",
        "FROM ecommerce.gold.customer_segments\n",
        "GROUP BY segment\n",
        "ORDER BY ingreso DESC\n"
      ]
    },
    {
      "name": "ds_products",
      "displayName": "Productos por ingreso",
      "queryLines": [
        "SELECT product_name, category, units_sold, revenue, profit,\n",
        "       round(margin_pct, 1) AS margen_pct, round(return_rate, 1) AS devolucion_pct\n",
        "FROM ecommerce.gold.product_performance\n",
        "ORDER BY revenue DESC\n",
        "LIMIT 20\n"
      ]
    },
    {
      "name": "ds_funnel",
      "displayName": "Embudo por canal",
      "queryLines": [
        "SELECT channel,\n",
        "       sum(page_views)   AS visitas,\n",
        "       sum(add_to_carts) AS al_carrito,\n",
        "       sum(checkouts)    AS inicio_pago,\n",
        "       sum(purchases)    AS compras,\n",
        "       round(100.0 * sum(purchases) / nullif(sum(page_views), 0), 2) AS conversion_pct\n",
        "FROM ecommerce.gold.marketing_funnel\n",
        "GROUP BY channel\n",
        "ORDER BY visitas DESC\n"
      ]
    },
    {
      "name": "ds_quality",
      "displayName": "Calidad de la última ejecución",
      "queryLines": [
        "WITH ultima AS (\n",
        "    SELECT run_id FROM ecommerce.ops.quality_results\n",
        "    ORDER BY checked_at DESC LIMIT 1\n",
        ")\n",
        "SELECT table AS tabla, column AS columna, rule AS regla, severity AS severidad,\n",
        "       rows_checked AS filas, rows_failed AS incumplen, round(pass_rate, 2) AS pct_ok\n",
        "FROM ecommerce.ops.quality_results\n",
        "WHERE run_id = (SELECT run_id FROM ultima) AND rows_failed > 0\n",
        "ORDER BY rows_failed DESC\n"
      ]
    }
  ],
